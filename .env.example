# OpenAI API key with Realtime API access. Required.
OPENAI_API_KEY=

# Realtime model. Defaults to gpt-realtime-2.1 if unset.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Voice. One of: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar.
# There's no official description of each voice's character, so preview a
# few yourself (e.g. in the OpenAI Realtime playground) and pick what fits.
# AI_BUTLER_VOICE=shimmer

# Global hotkey to toggle listening on/off. pynput combo syntax; Option key
# on macOS is <alt>. Defaults to Option+Space.
# AI_BUTLER_HOTKEY=<alt>+<space>

# How long (ms) to keep the mic muted after デヴィ finishes speaking, to avoid
# her voice from the speaker being picked back up by the mic.
# AI_BUTLER_MIC_COOLDOWN_MS=600

# sounddevice input/output device name or index. Leave unset to use the OS default.
# AI_BUTLER_INPUT_DEVICE=
# AI_BUTLER_OUTPUT_DEVICE=

# Path/command to your Claude Code CLI. Defaults to "claude" (must be on PATH).
# CLAUDE_CODE_COMMAND=claude

# Permission mode passed to `claude -p --permission-mode <...>` for
# unattended (voice-triggered) runs. Left unset by default: without a TTY,
# Claude Code cannot prompt for approval, so tool calls needing approval will
# typically be denied rather than hang -- which is the safe-but-limited
# default. Set this only once you understand the tradeoff, e.g.:
#   acceptEdits        - auto-approve file edits, still asks for other risky ops (N/A headless)
#   bypassPermissions   - skip ALL permission checks (see claude --help's own warning)
# CLAUDE_CODE_PERMISSION_MODE=

# Extra args appended to every `claude -p ...` invocation (shell-quoted).
# CLAUDE_CODE_EXTRA_ARGS=

# Give up on a single Claude Code task after this many seconds.
# CLAUDE_CODE_TIMEOUT_SEC=1800
